{
  "name": "@thenavidm/firefly-mcp-cli",
  "version": "2.0.0",
  "description": "Adobe Firefly MCP server, CLI and desktop extension for image generation, Image 5 editing, video, composites, upscaling and custom models.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "firefly-mcp": "dist/index.js",
    "firefly-cli": "dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "build:mcpb": "bash desktop-extension/build.sh",
    "check:counts": "node scripts/check-counts.mjs",
    "sync:api": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0",
    "@apidevtools/json-schema-ref-parser": "^14.0.0",
    "@anthropic-ai/mcpb": "2.1.2"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://github.com/thenavidm/firefly-mcp-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thenavidm/firefly-mcp-cli.git"
  },
  "bugs": {
    "url": "https://github.com/thenavidm/firefly-mcp-cli/issues"
  },
  "files": [
    "dist",
    "README.md",
    "INSTALL.md",
    "SKILL.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "keywords": [
    "adobe",
    "firefly",
    "mcp",
    "mcp-server",
    "cli",
    "image-generation",
    "video-generation",
    "claude",
    "codex",
    "ai-agents"
  ]
}
